{
  "name": "workshop",
  "version": "0.0.0",
  "private": true,
  "description": "Josh's personal monorepo for apps, scripts, and experiments.",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "test": "vitest run",
    "knip": "knip",
    "dev:backend": "pnpm --filter @workshop/backend dev",
    "dev:mobile": "pnpm --filter workshop-app start",
    "dev:highscore": "pnpm --filter highscore-app web",
    "dev:highscore:mobile": "pnpm --filter highscore-app start",
    "dev": "./scripts/dev.sh",
    "e2e": "./scripts/e2e.sh",
    "e2e:ui": "playwright test --ui",
    "deploy:backend": "./scripts/deploy.sh",
    "deploy:pages": "./scripts/deploy-pages.sh",
    "deploy:pages:preview": "./scripts/deploy-pages.sh --preview",
    "deploy:ota": "pnpm --filter workshop-app exec npx eas-cli@latest update --auto --branch production",
    "deploy:ios": "EAS_BUILD_NO_EXPO_GO_WARNING=true pnpm --filter workshop-app exec npx eas-cli@27.4.0 build --platform ios --profile production --auto-submit --non-interactive --no-wait",
    "deploy:ios:local": "./scripts/deploy-ios-xcode.sh",
    "deploy": "pnpm run deploy:backend && pnpm run deploy:ota && pnpm run deploy:ios",
    "deploy:local": "pnpm run deploy:backend && pnpm run deploy:ota && pnpm run deploy:ios:local",
    "setup:asc-key": "./scripts/setup-asc-key.sh",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "^1.64.1",
    "@total-typescript/ts-reset": "0.6.1",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "concurrently": "^9.2.5",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "prettier": "^3.9.10",
    "semver": "^7.7.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "workers-og": "^0.0.27"
  }
}
