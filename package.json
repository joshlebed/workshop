{
  "name": "workshop",
  "version": "0.0.0",
  "private": true,
  "description": "Josh's personal monorepo for apps, scripts, and experiments.",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=20.19 <21"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "test": "pnpm -r --parallel test",
    "knip": "knip",
    "dev:backend": "pnpm --filter @workshop/backend dev",
    "dev:mobile": "pnpm --filter workshop-app start",
    "dev": "./scripts/dev.sh",
    "e2e": "./scripts/e2e.sh",
    "e2e:ui": "playwright test --ui",
    "deploy:backend": "./scripts/deploy.sh",
    "deploy:pages": "./scripts/deploy-pages.sh",
    "deploy:pages:preview": "./scripts/deploy-pages.sh --preview",
    "deploy:ota": "pnpm --filter workshop-app exec npx eas-cli@latest update --auto --branch production",
    "deploy:ios": "EAS_BUILD_NO_EXPO_GO_WARNING=true pnpm --filter workshop-app exec npx eas-cli@18.8.1 build --platform ios --profile production --auto-submit --non-interactive --no-wait",
    "deploy:ios:local": "./scripts/deploy-ios-xcode.sh",
    "deploy": "pnpm run deploy:backend && pnpm run deploy:ota && pnpm run deploy:ios",
    "deploy:local": "pnpm run deploy:backend && pnpm run deploy:ota && pnpm run deploy:ios:local",
    "setup:asc-key": "./scripts/setup-asc-key.sh",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.60.0",
    "@total-typescript/ts-reset": "0.6.1",
    "concurrently": "^10.0.3",
    "knip": "6.16.1",
    "lefthook": "2.1.9",
    "prettier": "^3.8.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "workers-og": "^0.0.27"
  }
}
