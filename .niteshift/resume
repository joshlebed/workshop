#!/usr/bin/env bash
# Runs on every sandbox resume, before services are restarted. The only
# resume-specific recovery: the on-demand `postgres` service doesn't return
# automatically after a resume, so bring it back. Data lives in the
# workshop-pg17-data docker volume and survives the suspend; the prod copy is
# NOT re-taken here (use .niteshift/files/snapshot-prod.sh).
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"
log() { printf '[niteshift-resume] %s\n' "$*"; }

# shellcheck disable=SC1091
source "$REPO_DIR/.niteshift/files/toolchain.sh"
# shellcheck disable=SC1091
source "$REPO_DIR/.niteshift/files/db.sh"

workshop_resolve_database_url
log "restarting postgres service"
workshop_ensure_local_postgres
