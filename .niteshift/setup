#!/usr/bin/env bash
# Niteshift setup for joshlebed/workshop — finite, idempotent fresh-sandbox work.
# Long-running processes (backend, HighScore web, Workshop web, local
# postgres) are declared in .niteshift/services.yaml and supervised by
# `ns services`; this script only installs, migrates, and seeds.
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_DIR"
log() { printf '[niteshift-setup] %s\n' "$*"; }

# 1) Pinned toolchain (node 20.19 / pnpm 10.34 via mise).
# shellcheck disable=SC1091
source "$REPO_DIR/.niteshift/files/toolchain.sh"
log "installing pinned toolchain via mise"
workshop_ensure_toolchain "$REPO_DIR"

# 2) Keep the working tree clean — exclude files this lifecycle generates.
EXCLUDE_FILE=".git/info/exclude"
for entry in "apps/backend/.env" ".claude/"; do
  if ! grep -qxF "$entry" "$EXCLUDE_FILE" 2>/dev/null; then
    printf '%s\n' "$entry" >> "$EXCLUDE_FILE"
  fi
done

# 3) Database: always the local `postgres` service (any injected Neon
#    DATABASE_URL is ignored — see .niteshift/files/db.sh).
# shellcheck disable=SC1091
source "$REPO_DIR/.niteshift/files/db.sh"
workshop_resolve_database_url
log "starting local postgres service"
workshop_ensure_local_postgres

# 4) Dependencies.
log "pnpm install"
pnpm install --prefer-offline
# Playwright browser for `pnpm e2e`, pinned by the lockfile's @playwright/test.
log "playwright install chromium"
pnpm exec playwright install chromium

# 5) apps/backend/.env — the single place the resolved DATABASE_URL lands.
#    The `backend` service sources it (services don't receive setup's
#    repository variables), and drizzle-kit / seed tooling read it directly.
#    Dev auth is on by default: the web bundle auto-signs-in as the seeded
#    joshlebed@gmail.com user, so the preview lands signed in with no login.
: "${SESSION_SECRET:?SESSION_SECRET must be provided as a repository environment variable}"
log "writing apps/backend/.env"
umask 077
cat > apps/backend/.env <<ENV
STAGE=${STAGE:-local}
DATABASE_URL=${DATABASE_URL}
SESSION_SECRET=${SESSION_SECRET}
SES_FROM_ADDRESS=${SES_FROM_ADDRESS:-noreply@example.com}
AWS_REGION=${AWS_REGION:-us-east-1}
LOG_LEVEL=${LOG_LEVEL:-debug}
PORT=8787
DEV_AUTH_ENABLED=${DEV_AUTH_ENABLED:-1}
TYPESAFE_API_KEY=${TYPESAFE_API_KEY:-}
OPENAI_API_KEY=${OPENAI_API_KEY:-}
ENV
umask 022

# 6) Seed the local DB with a copy of prod (realistic repro). Needs the
#    sandbox AWS role to read /workshop-prod/db/url from SSM. PROD_SNAPSHOT=0
#    skips it. If the copy can't run, fall back to the synthetic dev seed.
#    Re-copy later with .niteshift/files/snapshot-prod.sh.
SNAPSHOTTED=0
if [ "${PROD_SNAPSHOT:-1}" = "1" ]; then
  log "copying prod database into local postgres"
  if workshop_snapshot_prod_into_local; then
    SNAPSHOTTED=1
  else
    log "prod snapshot unavailable — falling back to synthetic seed"
  fi
fi

# 7) Drizzle migrations — on top of the prod copy, so a branch's new
#    migrations get exercised against real data.
log "running db migrations"
pnpm --filter @workshop/backend run db:migrate

# 8) Synthetic dev seed, only when there's no prod copy (idempotent;
#    SEED_DEV_DATA=0 skips it, SEED_DEV_DATA=1 forces it).
SEED_DEFAULT=$((1 - SNAPSHOTTED))
if [ "${SEED_DEV_DATA:-$SEED_DEFAULT}" = "1" ]; then
  log "seeding dev data"
  pnpm --filter @workshop/backend run db:seed
else
  log "skipping synthetic dev seed (prod copy present or SEED_DEV_DATA=0)"
fi

log "setup complete"
