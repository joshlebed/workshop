{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**", ".claude/skills/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{sh,ts,mjs,js}", "functions/**/*.ts"],
      "ignoreDependencies": ["concurrently", "@workshop/shared"]
    },
    "apps/backend": {
      "entry": ["src/lambda.ts"]
    },
    "apps/workshop": {
      "entry": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@react-navigation/native"]
    },
    "packages/*": {}
  }
}
