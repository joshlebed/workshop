{
  "name": "workshop-app",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web --port 8082",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "expo prebuild",
    "eas:update": "eas update --auto --branch preview",
    "eas:build:ios": "eas build --platform ios --profile production --non-interactive",
    "eas:submit:ios": "eas submit --platform ios --latest --non-interactive"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "5.105.3",
    "@tanstack/query-sync-storage-persister": "5.105.3",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-query-persist-client": "5.105.3",
    "@workshop/api-client": "workspace:*",
    "@workshop/shared": "workspace:*",
    "@workshop/ui": "workspace:*",
    "expo": "58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-constants": "58.0.15",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-share-intent": "^9.0.0",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-updates": "58.0.21",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-reorderable-list": "0.18.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@types/react": "19.3.0",
    "babel-preset-expo": "58.0.24",
    "eas-cli": "27.4.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
