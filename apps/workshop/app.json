{
  "expo": {
    "name": "Workshop.dev",
    "slug": "workshop",
    "version": "0.5.0",
    "orientation": "portrait",
    "scheme": "workshop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.josh.workshop",
      "icon": "./assets/Workshop.dev.icon",
      "associatedDomains": ["applinks:workshop-a2v.pages.dev"],
      "entitlements": {
        "com.apple.security.application-groups": ["group.dev.josh.workshop"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.267582241036-cpnoae8vhaj8e3ftq3lmldef2c7hco33",
              "workshop"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "dev.josh.workshop"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "Workshop Share",
          "iosAppGroupIdentifier": "group.dev.josh.workshop",
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosHideView": true,
          "disableAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e395fb39-54cc-4841-a40a-c8d074f5db60"
    },
    "extra": {
      "apiUrl": "http://localhost:8787",
      "router": {},
      "eas": {
        "projectId": "e395fb39-54cc-4841-a40a-c8d074f5db60"
      }
    },
    "owner": "joshlebed"
  }
}
