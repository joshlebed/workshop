{
  "name": "highscore-app",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8082",
    "icon:build": "node scripts/build-icon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prebuild": "expo prebuild",
    "eas:build:ios": "eas build --platform ios --profile production --non-interactive",
    "eas:submit:ios": "eas submit --platform ios --latest --non-interactive"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@expo/metro-runtime": "~57.0.13",
    "@tanstack/react-query": "^5.100.1",
    "@workshop/api-client": "workspace:*",
    "@workshop/shared": "workspace:*",
    "@workshop/ui": "workspace:*",
    "expo": "57.0.16",
    "expo-apple-authentication": "~57.0.1",
    "expo-constants": "57.0.14",
    "expo-image-picker": "~57.0.13",
    "expo-router": "57.0.16",
    "expo-secure-store": "57.0.1",
    "expo-share-intent": "^8.0.1",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.2",
    "expo-updates": "57.0.17",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-keyboard-controller": "1.22.4",
    "react-native-reanimated": "4.2.1",
    "react-native-reorderable-list": "0.18.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.7.4",
    "workers-og": "^0.0.27",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@types/react": "19.2.14",
    "babel-preset-expo": "55.0.18",
    "eas-cli": "18.8.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
