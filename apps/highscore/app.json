{
  "expo": {
    "name": "HighScore",
    "slug": "highscore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0C0B"
    },
    "scheme": "highscore",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "live.highscore.app",
      "icon": "./assets/HighScore.icon",
      "associatedDomains": ["applinks:highscore.live"],
      "entitlements": {
        "com.apple.security.application-groups": ["group.live.highscore.app"]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.267582241036-7vtcgkd594ldgimcu3dickj9u5ga951l",
              "highscore"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "live.highscore.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0C0B"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "HighScore Share",
          "iosAppGroupIdentifier": "group.live.highscore.app",
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          },
          "iosHideView": true,
          "disableAndroid": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/92a568f5-b0f0-4af1-bb9d-98181025691c"
    },
    "extra": {
      "apiUrl": "http://localhost:8787",
      "router": {},
      "eas": {
        "projectId": "92a568f5-b0f0-4af1-bb9d-98181025691c"
      }
    },
    "owner": "joshlebed"
  }
}
