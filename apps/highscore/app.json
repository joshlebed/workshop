{
  "expo": {
    "name": "HighScore",
    "slug": "highscore",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "highscore",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "live.highscore.app",
      "associatedDomains": ["applinks:highscore.live"],
