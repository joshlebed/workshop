{
  "name": "@workshop/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node ./scripts/bundle.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "admin:eject": "tsx scripts/eject-user.ts",
    "admin:game-code": "tsx scripts/set-game-code.ts",
    "admin:game-direction": "tsx scripts/set-game-direction.ts",
    "admin:reread-scores": "tsx scripts/reread-scores.ts",
    "admin:handwritten-formatters": "tsx scripts/apply-handwritten-formatters.ts",
    "admin:reformat-scores": "tsx scripts/reformat-scores.ts",
    "ops:catalog-audit": "tsx scripts/catalog-audit.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@workshop/shared": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.15",
    "postgres": "3.4.9",
    "quickjs-emscripten-core": "0.32.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "3.1161.0",
    "@aws-sdk/client-ssm": "3.1161.0",
    "@electric-sql/pglite": "^0.5.15",
    "@types/node": "25.9.9",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
