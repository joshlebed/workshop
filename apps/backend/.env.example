STAGE=local
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workshop
SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32_at_least_32_chars
AWS_REGION=us-east-1
LOG_LEVEL=debug
PORT=8787

# Spotify Web API app credentials (Client Credentials flow). Used by the
# Album Shelf feature to read public playlists. Register an app at
# https://developer.spotify.com/dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Sign in with Apple server-to-server credentials. Only needed to exchange a
# sign-in authorization code for a refresh token and revoke it when a user
# deletes their account (App Store Review Guideline 5.1.1(v)). Empty in local
# dev — deletion still works and honestly reports revocation as "unavailable".
# Prod values live in SSM at /workshop-prod/apple_{team_id,key_id,private_key}.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Discord webhook for operator-facing notifications (new signups, new lists).
# Leave empty in local dev — the notifier no-ops when unset. Prod value lives
# in SSM at /workshop-prod/discord/notify_webhook_url.
DISCORD_NOTIFY_WEBHOOK_URL=
