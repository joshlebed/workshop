{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**", ".claude/skills/**"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{sh,ts,mjs,js}", "functions/**/*.ts"],
      // eas-cli: scripts/eas-sync-ios-capabilities.mjs resolves it from the app
      // dir it is given (apps/*/devDependencies), not the root.
      // @expo/fingerprint: scripts/expo-fingerprint-config.cjs is loaded by each
      // app's fingerprint.config.cjs; the dependency is declared by the apps.
      "ignoreDependencies": ["concurrently", "eas-cli", "@expo/fingerprint"]
    },
    "apps/backend": {
      "entry": [
        "src/lambda.ts",
        "src/lib/gameCode/sandboxWorker.ts",
        "src/lib/sources/scheduler.ts",
        "src/lib/sources/webhookSignature.ts",
        "src/lib/sources/secrets.ts",
        "scripts/*.{ts,mjs}"
      ]
    },
    "apps/workshop": {
      "entry": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "fingerprint.config.cjs"],
      "ignoreDependencies": ["@react-navigation/native"]
    },
    "apps/highscore": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "functions/**/*.ts",
        "scripts/*.mjs",
        "fingerprint.config.cjs"
      ],
      // Natives preloaded into the 1.2.0 binary so later features ship OTA-only —
      // intentionally unused for now (apps/highscore/CLAUDE.md). Remove each one
      // from this list in the PR that first imports it.
      "ignoreDependencies": [
        "expo-application",
        "expo-blur",
        "expo-device",
        "expo-haptics",
        "expo-image",
        "expo-linear-gradient",
        "expo-sharing",
        "expo-store-review",
        "react-native-mmkv",
        "react-native-nitro-modules",
        "react-native-svg"
      ]
    },
    "packages/*": {}
  }
}
