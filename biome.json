{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "warn"
      },
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "warn",
        "noReactNativeRawText": {
          "level": "error",
          "options": {
            "skip": ["RNText"]
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!.agents",
      "!**/dist",
      "!**/build",
      "!**/.expo",
      "!**/.next",
      "!**/*.generated.*",
      "!**/apps/backend/drizzle",
      "!**/apps/workshop/expo-env.d.ts",
      "!**/apps/highscore/expo-env.d.ts",
      "!**/infra/.terraform",
      "!**/*.icon",
      "!**/test-results",
      "!**/playwright-report",
      "!**/.wrangler"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.web.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noReactNativeRawText": "off"
          }
        }
      }
    }
  ]
}
